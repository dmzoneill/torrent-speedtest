# Public IP or Domain of your VPS (e.g., speedtest.fio.ie or 198.51.100.1).
# If left as 'auto', the container will auto-detect its public IPv4 on boot.
PUBLIC_HOST=auto

# Port for Web UI and Tracker Announce
HTTP_PORT=8080

# BitTorrent peer wire transfer port for Transmission seeder (TCP & UDP)
PEER_PORT=51413

# Size of the generated speed test payload file in GB
FILE_SIZE_GB=5.0

# BitTorrent piece size in MB (4MB recommended for 5GB files)
PIECE_SIZE_MB=4
